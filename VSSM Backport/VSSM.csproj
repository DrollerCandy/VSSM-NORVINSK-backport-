<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VSSM</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>0.0.1</Version>
    <OutputPath>$(MSBuildProjectDirectory)/../release/VSSM/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);release/**;obj/**;bin/**;SPT-AKResonant-3.0.0/**;WTT-CommonLib-3.0.6/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <None Include="db/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>db/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="bundles/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bundles/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="vssm/bundles/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bundles/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="vssm/bundles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bundles.json</Link>
    </None>
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
    <PackageReference Include="WTT-ServerCommonLib" Version="3.*" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>